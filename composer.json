{
    "name": "skurfuerst/cr-standalone",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "lint:phpstan": "vendor/bin/phpstan analyse"
    },
    "authors": [
        {
            "name": "Sebastian Kurfuerst",
            "email": "sebastian.kurfuerst@sandstorm.de"
        }
    ],
    "require": {
        "neos/contentrepository-core": "~9.0",
        "neos/contentgraph-doctrinedbaladapter": "~9.0",
        "symfony/yaml": "^6.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.11"
    },
    "config": {
        "allow-plugins": {
            "neos/composer-plugin": false
        }
    }
}
